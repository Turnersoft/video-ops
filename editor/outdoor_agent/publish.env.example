# Outdoor publish credentials (Mac agent)
# Prefer outdoor UI #/platforms → Publish credentials
# (stored in data/publish-credentials.json, gitignored).

# --- Postiz self-host (English) ---
# Start: cd ~/Documents/company/postiz-docker-compose && docker compose up -d
# UI: http://localhost:4007
# Guide: docs/postiz-self-host-connect.md
export POSTIZ_API_BASE=http://localhost:4007/api/public/v1
export POSTIZ_DASHBOARD_URL=http://localhost:4007
export POSTIZ_API_KEY=
export POSTIZ_INTEGRATIONS_JSON='{}'
export POSTIZ_PUBLISH_MODE=stub
# export POSTIZ_PUBLISH_MODE=live

# --- SAU (China) ---
export SAU_BIN=/Users/johndoe/.local/bin/sau
export SAU_REPO=/Users/johndoe/Documents/company/social-auto-upload
export SAU_ACCOUNT=default
export SAU_PUBLISH_MODE=stub
# export SAU_PUBLISH_MODE=live
