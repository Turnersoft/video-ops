{
  "version": 1,
  "typing": {
    "charsPerSecond": 28,
    "fullText": "@notation(chain({A_{i}}, \" × \"))\nstructure CartesianProduct<n: Int, for i in 1..n [A_{i}: Set<Any>]>: Set<Any> {\n    laws {\n        def {\n            forall x_{i} in A_{i} |- [x_{i}] in self\n        }\n    }\n}"
  },
  "proofPanel": {
    "steps": [
      {
        "label": "open goal",
        "goal": "⊢ target proposition"
      },
      {
        "label": "apply tactic",
        "goal": "subgoal after apply"
      },
      {
        "label": "close branch",
        "goal": "no open goals"
      }
    ]
  },
  "interactions": [
    {
      "atSeconds": 1.5,
      "kind": "click-proof-step",
      "stepIndex": 0
    },
    {
      "atSeconds": 3.2,
      "kind": "click-proof-step",
      "stepIndex": 1
    },
    {
      "atSeconds": 5,
      "kind": "click-branch",
      "branchId": "main"
    }
  ]
}
