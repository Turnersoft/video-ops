
structure[T] Set<T: Any> {
}

relation Subset(T: Any, A B: Set<T>): PropModified {
    @notation({A} ~ " ⊆ " ~ {B})
    default: Prop {
        forall x: T |- x in A -> x in B
    },
    @notation({A} ~ " ⊊ " ~ {B})
    proper: Prop {
        |- {
            default(A, B);
            not SetEq(A, B);
        }
    }
}

@notation({A} ~ " = " ~ {B})
relation SetEq(T: Any, A B: Set<T>): Prop {
    |- {
        Subset(A, B);
        Subset(B, A);
    }
}

@notation("∅")
structure EmptySet: Set<Any> {
    laws {
        no_members {
            forall x: Any |- not (x in self)
        }
    }

}

axiom "Or associativity" {
    forall P Q R: Prop |- ((P or Q) or R) <-> (P or (Q or R))
}
theorem "Empty subset of every set (Judson sect. 1.2)" {
    forall S: Set<Any> |- Subset(EmptySet, S)
} proof {
	unfold Subset at goal
	assume_not {
		normalize_negation at goal
		contradiction goal.1 by EmptySet.no_members
	}
}


@notation({A} ~ " ∪ " ~ {B})
structure Union<T: Any, A B: Set<T>>: Set<T> {
    laws {
        def {
            forall x in self |- x in A or x in B
        }
    }
}

@notation({A} ~ " ∩ " ~ {B})
structure[T] Intersect<T: Any, A B: Set<T>>: Set<T> {
    laws {
        def {
            forall x in self |- {
                x in A;
                x in B;
            }
        }
    }
}

@notation(adjective)
relation Disjoint(T: Any, A B: Set<T>): Prop {
    |- SetEq(Intersect(A, B), EmptySet)
}

@notation({A}~"'")
structure Complement<T: Any, U: Set<T>, A: Set<T> where { |- Subset(A, U); }>: Set<T> {
    laws {
        def {
            forall x in self |- {
                x in U;
                not (x in A);
            }
        }
    }
}

@notation({A} ~ " ∖ " ~ {B})
structure[T] Difference<T: Any, A B: Set<T>>: Set<T> {
    laws {
        def {
            forall x in self |- {
                x in A;
                not (x in B);
            };
            forall U: Set<T> where {|- Subset(B, U)}
            |- self = Intersect(A, Complement(U, B))
        }
    }
}

theorem "Difference versus complement in a universe" {
    forall T: Any,
    forall U A B: Set<T>
    where {
        |- Subset(B, U);
        |- Subset(A, U);
    }
    |- SetEq(Difference(A, B), Intersect(A, Complement(U, B)))
} proof {
	unfold SetEq
	unfold Subset at goal.1 goal.2
	split_conjunction {
		assume h
		unfold Difference.def at h
		split_assumption_conjunction h into hA hNotB
		unfold Intersect.def
		split_conjunction {
			exact hA
		} {
			unfold Complement.def
			split_conjunction {
				unfold Subset at assum_1
				apply assum_1 on hA into hU
				exact hU
			} {
				exact hNotB
			}
		}
	} {
		assume h
		unfold Intersect.def at h
		split_assumption_conjunction h into hA hComp
		unfold Complement.def at hComp
		split_assumption_conjunction hComp into hU hNotB
		unfold Difference.def
		split_conjunction {
			exact hA
		} {
			exact hNotB
		}
	}
}

// :: Symmetric difference $A\triangle B = (A\setminus B)\cup(B\setminus A)$ (common aside; used in some exercises).

@notation({A} ~ " △ " ~ {B})
structure SymmetricDifference<T: Any, A B: Set<T>>: Set<T> {
    laws {
        def {
            forall x: T |- x in self <-> {
                x in Union(Difference(A, B), Difference(B, A));
            };
            |- SetEq(self, Union(Difference(A, B), Difference(B, A)))
        }
    }
}

theorem "Symmetric halves of asymmetric difference disjoint (example in Judson sect. 1.2)" {
    forall T: Any,
    forall A B: Set<T>
    |- SetEq(T, Intersect(Difference(A, B), Difference(B, A)), EmptySet)
} proof {
	unfold SetEq
	split_conjunction {
		unfold Subset at goal
		assume_not {
			normalize_negation at goal
			unfold Intersect.def at goal.1
			unfold Difference.def at goal.1.1 goal.1.2
			contradiction goal.1.2.1 goal.1.1.2
		}
	} {
		unfold Subset at goal
		assume_not {
			normalize_negation at goal
			contradiction goal.1 by EmptySet.no_members
		}
	}
}

:: Algebra of unions, intersections, and differences (Judson proposition — `sets.xml` before De Morgan)

theorem "basic set" {
    forall A B C: Set<Any> |- {
        p1: {
            first: SetEq(Union(A, A), A) proof {
				unfold SetEq
				unfold Subset at goal.1 goal.2
				split_conjunction {
					assume h
					unfold Union.def at h
					split_assumption_disjunction h {
						exact h_left
					} {
						exact h_right
					}
				} {
					assume h
					unfold Union.def at goal
					reduce goal to left
					exact h
				}
				
			};
            second: SetEq(Intersect(A, A), A) proof {
                // comment
				unfold SetEq //comment
				unfold Subset at goal.1 goal.2
				split_conjunction {
					assume h
					unfold Intersect.def at h
					split_assumption_conjunction h into h1 h2
                    // comment
					exact h1 //comment
                    // comment is here
				} {
					assume h
					unfold Intersect.def at goal
					split_conjunction {
						exact h
					} {
						exact h
					}
				}
				
			};
            third: SetEq(Difference(A, A), EmptySet) proof {
				unfold SetEq
				unfold Subset at goal.1 goal.2
				split_conjunction {
					assume_not {
						normalize_negation at goal
						unfold Difference.def at goal.1
						contradiction goal.1.1 goal.1.2
					}
				} {
					assume_not {
						normalize_negation at goal
						contradiction goal.1 by EmptySet.no_members
					}
				}
			}
        };
        p2: {
            SetEq(Union(A, EmptySet), A) proof {
				unfold SetEq
				unfold Subset at goal.1 goal.2
				split_conjunction {
					assume h
					unfold Union.def at h
					split_assumption_disjunction h {
						exact h_left
					} {
						assume_not {
							apply EmptySet.no_members on h_right into hNoMem
							contradiction hNoMem
						}
					}
				} {
					assume h
					unfold Union.def at goal
					reduce goal to left
					exact h
				}
			}; 
            SetEq(Intersect(A, EmptySet), EmptySet) proof {
				unfold SetEq
				unfold Subset at goal.1 goal.2
				split_conjunction {
					assume h
					unfold Intersect.def at h
					split_assumption_conjunction h into h1 h2
					exact h2
				} {
					assume_not {
						normalize_negation at goal
						contradiction goal.1 by EmptySet.no_members
					}
				}
			};
        };
        p3: {
            SetEq(Union(A, Union(B, C)), Union(Union(A, B), C)) proof {
				unfold SetEq
				unfold Subset at goal.1 goal.2
				split_conjunction {
					assume h
					unfold Union.def at goal h
					unfold Union.def at goal.1
					split_assumption_disjunction h {
						reduce goal to 1
						reduce goal to 1
						exact h_left
					} {
						reduce goal.1 to right
						unfold Union.def at h_right
						exact h_right
					}
				} {
					assume h
					unfold Union.def at goal h
					unfold Union.def at h.1 goal.2
					apply "Or associativity" on h
					exact h
				}
			};
            SetEq(Intersect(A, Intersect(B, C)), Intersect(Intersect(A, B), C)) proof {
				unfold SetEq
				unfold Subset at goal.1 goal.2
				split_conjunction {
					assume h
					unfold Intersect.def at goal h
					unfold Intersect.def at goal.1
					split_assumption_conjunction h into h1 h2
					unfold Intersect.def at h2
					split_assumption_conjunction h2 into h2a h2b
					split_conjunction {
						split_conjunction {
							exact h1
						} {
							exact h2a
						}
					} {
						exact h2b
					}
				} {
					assume h
					unfold Intersect.def at goal h
					unfold Intersect.def at h.1 goal.2
					split_assumption_conjunction h into hAB hC
					split_assumption_conjunction hAB into hA hB
					split_conjunction {
						exact hA
					} {
						split_conjunction {
							exact hB
						} {
							exact hC
						}
					}
				}
			};
        };
        p4: {
            SetEq(Union(A, B), Union(B, A)) proof {
				unfold SetEq
				unfold Subset at goal.1 goal.2
				split_conjunction {
					assume h
					unfold Union.def at goal h
					split_assumption_disjunction h {
						reduce goal to right
						exact h_left
					} {
						reduce goal to left
						exact h_right
					}
				} {
					assume h
					unfold Union.def at goal h
					split_assumption_disjunction h {
						reduce goal to right
						exact h_left
					} {
						reduce goal to left
						exact h_right
					}
				}
			};
            SetEq(Intersect(A, B), Intersect(B, A)) proof {
				unfold SetEq
				unfold Subset at goal.1 goal.2
				split_conjunction {
					assume h
					unfold Intersect.def at goal h
					split_assumption_conjunction h into h1 h2
					split_conjunction {
						exact h2
					} {
						exact h1
					}
				} {
					assume h
					unfold Intersect.def at goal h
					split_conjunction {
						exact h.2
					} {
						exact h.1
					}
				}
			};
        };
        p5: SetEq(Union(A, Intersect(B, C)), Intersect(Union(A, B), Union(A, C))) proof {
			unfold SetEq
			unfold Subset at goal.1 goal.2
			split_conjunction {
				assume h
				unfold Union.def at h
				unfold Intersect.def at goal
				split_conjunction {
					unfold Union.def
					split_assumption_disjunction h into hA hBC {
						reduce goal to left
						exact hA
					} {
						unfold Intersect.def at hBC
						split_assumption_conjunction hBC into hB hC
						reduce goal to right
						exact hB
					}
				} {
					unfold Union.def
					split_assumption_disjunction h into hA hBC {
						reduce goal to left
						exact hA
					} {
						unfold Intersect.def at hBC
						split_assumption_conjunction hBC into hB hC
						reduce goal to right
						exact hC
					}
				}
			} {
				assume h
				unfold Intersect.def at h
				split_assumption_conjunction h into hAB hAC
				unfold Union.def at goal hAB hAC
				split_assumption_disjunction hAB into hA hB {
					reduce goal to left
					exact hA
				} {
					split_assumption_disjunction hAC into hA2 hC {
						reduce goal to left
						exact hA2
					} {
						reduce goal to right
						unfold Intersect.def
						split_conjunction {
							exact hB
						} {
							exact hC
						}
					}
				}
			}
		};
        p6: SetEq(Intersect(A, Union(B, C)), Union(Intersect(A, B), Intersect(A, C))) proof {
			unfold SetEq
			unfold Subset at goal.1 goal.2
			split_conjunction {
				assume h
				unfold Intersect.def at h
				split_assumption_conjunction h into hA hBC
				unfold Union.def at goal hBC
				split_assumption_disjunction hBC into hB hC {
					reduce goal to left
					unfold Intersect.def
					split_conjunction {
						exact hA
					} {
						exact hB
					}
				} {
					reduce goal to right
					unfold Intersect.def
					split_conjunction {
						exact hA
					} {
						exact hC
					}
				}
			} {
				assume h
				unfold Union.def at h
				unfold Intersect.def at goal
				split_assumption_disjunction h into hAB hAC {
					unfold Intersect.def at hAB
					split_assumption_conjunction hAB into hA hB
					split_conjunction {
						exact hA
					} {
						unfold Union.def
						reduce goal to left
						exact hB
					}
				} {
					unfold Intersect.def at hAC
					split_assumption_conjunction hAC into hA hC
					split_conjunction {
						exact hA
					} {
						unfold Union.def
						reduce goal to right
						exact hC
					}
				}
			}
		};
    }
}

theorem "de morgan's laws" {
    forall A B U: Set<Any> where {|- Subset(A, U); |- Subset(B, U);} |- {
        p1: SetEq(Complement(U, Union(A, B)), Intersect(Complement(U, A), Complement(U, B))) proof {
			unfold SetEq
			unfold Subset at goal.1 goal.2
			split_conjunction {
				assume h
				unfold Complement.def at h
				unfold Intersect.def
				split_conjunction {
					unfold Complement.def
					split_conjunction {
						exact h.1
					} {
						unfold Union.def at h.2
						split_assumption_disjunction h.2 
						exact h.2.1
					}
				} {
					unfold Complement.def
					split_conjunction {
						exact h.1
					} {
						unfold Union.def at h.2
						split_assumption_disjunction h.2
						exact h.2.2
					}
				}
			} {
				assume h
				unfold Intersect.def at h
				split_assumption_conjunction h into hA hB
				unfold Complement.def at hA hB goal
				split_conjunction {
					exact hA.1
				} {
					unfold Union.def at goal
					de_morgan goal
					split_conjunction {
						exact hA.2
					} {
						exact hB.2
					}
				}
			}
		};
        p2: SetEq(Complement(U, Intersect(A, B)), Union(Complement(U, A), Complement(U, B))) proof {
			unfold SetEq
			unfold Subset at goal.1 goal.2
			split_conjunction {
				assume h
				unfold Complement.def at h
				unfold Intersect.def at h.2
				de_morgan h.2
				unfold Union.def at goal
				split_assumption_disjunction h.2 {
					reduce goal to left
					unfold Complement.def
					exact h
				} {
					reduce goal to right
					unfold Complement.def
					exact h
				}
			} {
				assume h
				unfold Union.def at h
				split_assumption_disjunction h into hA hB {
					unfold Complement.def at hA
					unfold Complement.def at goal
					split_conjunction {
						exact hA.1
					} {
						unfold Intersect.def at goal
						de_morgan goal
						reduce goal to left
						exact hA.2
					}
				} {
					unfold Complement.def at hB
					unfold Complement.def at goal
					split_conjunction {
						exact hB.1
					} {
						unfold Intersect.def at goal
						de_morgan goal
						reduce goal to right
						exact hB.2
					}
				}
			}
		};
    }
}


@notation(chain({A_{i}}, " × "))
structure CartesianProduct<n: Int, [forall i in 1..n | A_{i}: Set<Any>]>: Set<Any> {
    laws {
        def {
            forall x_{i} in A_{i} |- [x_{i}] in self
        }
    }
}

structure Relation<A B: Set<Any>>: Set<Any> {
    laws {
        subset {
            |- Subset(self, CartesianProduct<[A, B]>)
        }
    }

    properties {
        well_defined: Prop {
            forall a in A,
            exists unique b in B 
            |- {
                [a b] in self;
            }
        }
    }
}

@notation({self} ~ fromTo({domain}, {range}))
structure Function<domain range: Set<Any>>: (well_defined)Relation<domain, range> {
    @notation( {self} ~ "(" ~ {a} ~ ")" )
    apply(a: domain): range,

    properties {
        @notation(adjective)
        surjective: Prop {
            forall b in range,
            exists a in domain
            |- apply(a) = b
        }

        @notation(adjective)
        injective: Prop {
            forall a_1 a_2 in domain
            |- a_1 != a_2 -> apply(a_1) != apply(a_2)
        }

        @notation(adjective)
        bijective: (surjective, injective)

        @notation(adjective)
        invertible: Prop {
            |- exists InverseFunction<self>
        }
    }
    laws {
        domain_def {
            forall a in domain |- apply(a) in range
        }
    }
}

:: Judson function equality on aligned carriers (statement-level).
@notation({f} ~ " = " ~ {g})
relation FuncEq(X Y X' Y': Set<Any>, f: Function<X, Y>, g: Function<X', Y'>): Prop {
    forall x in X |- {
        SetEq(X, X');
        SetEq(Y, Y');
		f.apply(x) = g.apply(x);
    }
}

@notation({g} ~ " ∘ " ~ {f})
structure Composition<A B C: Set<Any>, f: Function<A, B>, g: Function<B, C>>: Function<A, C> {
    apply(domain: A): C
    laws {
        def {
            forall x in A
            |- apply(x) = g.apply(f.apply(x))
        }
    }
}


theorem "composition's rules" {
    forall A B C D: Set<Any>,
    forall f: Function<A, B>,
    forall g: Function<B, C>,
    forall h: Function<C, D>,
    |- {
        associative: Composition<f, Composition<g, h>> = Composition<Composition<f, g>, h> proof {
			intro x in A
			congr call Composition.apply(x)
			unfold Composition.def at goal.1 goal.2
			unfold Composition.def at goal.1 goal.2.2
			reflexivity
			
		};
        injective: ((injective)f and (injective)g) -> (injective)Composition<f, g> proof {
			assume prem
			split_assumption_conjunction prem into h1 h2
			unfold Function.injective at h1 h2 goal
			assume hneq
			unfold Composition.def at goal.1 goal.2
			apply h1 on hneq into hFneq
			apply h2 on hFneq into hGneq
			exact hGneq
		};
        surjective: ((surjective)f and (surjective)g) -> (surjective)Composition<f, g> proof {
			assume prem
			split_assumption_conjunction prem into h1 h2
			unfold Function.surjective at goal
			unfold Composition.def at goal.1
			unfold Function.surjective at h1
			unfold Function.surjective at h2
			specialize h2 for d as b into hGi
			witness d0 for c in hGi
			specialize h1 for b as d0 into hFa
			witness a0 for a in hFa
			witness a0 for a
			rewrite hFa
			exact hGi
		};
        bijective: ((bijective)f and (bijective)g) -> (bijective)Composition<f, g> proof {
			assume prem
			split_assumption_conjunction prem into hf hg
			unfold Function.bijective at hf hg goal
			split_assumption_conjunction hf into fs fi
			split_assumption_conjunction hg into gs gi
			split_conjunction {
				unfold Function.surjective at goal
				unfold Composition.def at goal.1
				unfold Function.surjective at fs
				unfold Function.surjective at gs
				specialize gs for d as b into hGi
				witness d0 for c in hGi
				specialize fs for b as d0 into hFa
				witness a0 for a in hFa
				witness a0 for a
				rewrite hFa
				exact hGi
			} {
				unfold Function.injective at fi gi goal
				assume hneq
				unfold Composition.def at goal.1 goal.2
				apply fi on hneq into hFneq
				apply gi on hFneq into hGneq
				exact hGneq
			}
		};
    }

}



// identity mapping always exist (what about on empty sets?) becuase there is no identitibility law on function
@notation("id"_{S})
structure IdentityFunction<S: Set<Any>>: Function<S, S> {
    laws {
        def {
            forall s in S 
            |- apply(s) = s
        }
    }
}

// we don't put (invertible)Function in the generic.
structure InverseFunction<A B: Set<Any>, f: Function<A, B>>: Function<B, A> {
    laws {
        def {
            |- {
                Composition<self, f> = IdentityFunction<B>;
                Composition<f, self> = IdentityFunction<A>;
            }
        }
    }
}


theorem "invertible mapping must be injective" {
	forall f: Function
	|- (invertible)f -> (injective, surjective)f
} proof {
	assume hInv
	unfold Function.invertible at hInv
	witness gInv for inv in hInv
	split_assumption_conjunction hInv into hFg hGf
	split_conjunction {
		unfold Function.injective at goal
		assume hneq
		assume_not {
			normalize_negation at goal
			unfold Composition.def at hGf
			specialize hGf for x as a_1 into hLeft
			specialize hGf for x as a_2 into hRight
			apply goal.1 on hLeft into hLeft2
			apply hLeft2 on hRight into hAeq
			contradiction hneq hAeq
		}
	} {
		unfold Function.surjective at goal
		unfold Composition.def at hFg
		specialize hFg for x as b into hCover
		witness gInv.apply(b) for a
		exact hCover
	}
}

structure EquivalenceRelation<X: Set<Any>>: Relation<X, X> {
    laws {
        basic {
            forall x y z in X 
            |- {
                reflexive: [x x] in self;
                symmetric: [x y] in self -> [y x] in self;
                transitive: ([x y] in self and [y z] in self) -> [x z] in self;
            }
        },
        same_class_rep {
            forall wa wb in X
            |- [wa wb] in self -> SetEq(EquivalenceClass<X, self, wa>, EquivalenceClass<X, self, wb>)
        },
        class_set_eq_from_rep {
            forall wa wb in X, forall A B: Set<Any>
            |- {
                SetEq(A, EquivalenceClass<X, self, wa>);
                SetEq(B, EquivalenceClass<X, self, wb>);
                [wa wb] in self;
            } -> SetEq(A, B)
        }
    }
}


structure[
    C: Set<Any> where {
        |- C != EmptySet;
        |- Subset(C, X)
    }
] Partition<
    X: Set<Any>
>: Set<Set<Any>> 
{
    laws {
        disjoint {
            forall partA partB in self where { |- not SetEq(partA, partB) } |-
            SetEq(Intersect(partA, partB), EmptySet)
        },
        cover {
            forall x in X,
            exists C in self
            |- x in C
        }
    }
}

structure EquivalenceClass<
    X: Set<Any>,
    E: EquivalenceRelation<X>,
    x in X,
>: Set<Any> {
    laws {
        def {
            forall y in X |- y in self <-> [x y] in E;
        },
        from_relation {
            forall y in X |- [x y] in E -> y in self;
        },
        subset {
            |- Subset(self, X);
        }
    }
}
 

theorem "equivalence class members lie in the ambient set" {
    forall X: Set<Any>, 
	forall E: EquivalenceRelation<X>, 
	forall x in X, 
	forall y: Any,
	|-(y in EquivalenceClass<X, E, x>) -> (y in X)
} proof {
	assume hMem
	apply "equivalence class members lie in the ambient set" on hMem into hInX
	exact hInX
}

theorem "equivalence classes form a partition (Judson Theorem 1.25 forward)" {
    forall X: Set<Any>,
    forall E: EquivalenceRelation<X>,
    exists Classes: Set<Set<Any>> where {
        forall C in Classes, 
		exists x in X,
		|- SetEq(C, EquivalenceClass<X, E, x>);
		
        forall x' in X 
		|- EquivalenceClass<X, E, x'> in Classes;
    },
    |- exists Partition<X>[..Classes]
} proof {
	witness confirm {
		at goal {
			C.1 {
				specialize Classes.1 for C as D into hRep
				witness w for x in hRep
				intro w in X
				unfold SetEq at hRep
				unfold Subset at hRep.2
				specialize E.basic.reflexive into hWwE
				specialize EquivalenceClass.from_relation for y as w into hFromRel
				apply hFromRel on hWwE into hWinEC
				apply hRep.2 on hWinEC into hWinD
				assume_not {
					normalize_negation at goal
					apply goal.1 on hWinD into hWinEmpty
					contradiction hWinEmpty by EmptySet.no_members
				}
			}
			C.2 {
				specialize Classes.1 for C as D into hRep
				witness wC for x in hRep
				intro wC in X
				unfold SetEq at hRep
				unfold Subset at goal
				unfold Subset at hRep.1
				assume hy
				apply hRep.1 on hy into hYinE
				apply "equivalence class members lie in the ambient set" on hYinE into hInX
				exact hInX
			}
			cover {
				witness EquivalenceClass<X, E, x> for C
				unfold EquivalenceClass.def at goal
				specialize E.basic.reflexive into hRef
				exact hRef
				specialize Classes.2 for x' as x into hClass
				exact hClass
			}
			disjoint {
				unfold SetEq at goal
				split_conjunction {
					unfold Subset at goal
					assume_not {
						normalize_negation at goal
						unfold Intersect.def at goal.1
						specialize Classes.1 for C as partA into hRepA
						witness wa for x in hRepA
						intro wa in X
						specialize Classes.1 for C as partB into hRepB
						witness wb for x in hRepB
						intro wb in X
						unfold SetEq at hRepA hRepB
						unfold Subset at hRepA.1 hRepB.1
						apply hRepA.1 on goal.1.1
						apply hRepB.1 on goal.1.2
						unfold EquivalenceClass.def at goal.1.1 goal.1.2
						apply E.basic.symmetric on goal.1.2
						apply E.basic.transitive on goal.1.1, goal.1.2
						fold Subset at hRepA.1 hRepB.1
						fold SetEq at hRepA hRepB
						apply E.class_set_eq_from_rep on hRepA, hRepB, goal.1
						contradiction goal.1 with partA.1
					}
				} {
					unfold Subset at goal
					assume_not {
						normalize_negation at goal
						contradiction goal.1 by EmptySet.no_members
					}
				}
			}
		}
	}
}

