:: Standalone excerpt for sets-v2-04 (equality clip).
:: Pointwise function equality — the direct parallel to Lean's `funext`.
:: Kept separate from AATA 02_sets_and_equivalence_relations.turn, whose
:: `FuncEq` means "aligned carriers" (same domain + codomain), not pointwise.

structure[T] Set<T: Any> {
}

relation Subset(T: Any, A B: Set<T>): Prop {
    forall x: T
    |- x in A -> x in B
}

@notation({A} ~ " = " ~ {B})
relation SetEq(T: Any, A B: Set<T>): Prop {
    |- {
        Subset(A, B);
        Subset(B, A);
    }
}

@notation({self} ~ fromTo({domain}, {range}))
structure Function<domain range: Set<Any>> {
    @notation( {self} ~ "(" ~ {a} ~ ")" )
    apply(a: domain): range
}

:: Two functions are equal when they agree on every input.
:: This is exactly `funext`, written as the definition of `=` on functions.
@notation({f} ~ " = " ~ {g})
relation FunctionEq(X Y: Set<Any>, f g: Function<X, Y>): Prop {
    forall x in X
    |- f(x) = g(x)
}
