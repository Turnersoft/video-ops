{
  "name": "turn-video-outdoor-teleprompter",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "start:tunnel:outdoor": "deno run --allow-all ./scripts/start-expo-tunnel-outdoor.ts",
    "start:tailscale": "deno run --allow-all ./scripts/start-with-tailscale.ts",
    "start:outdoor": "deno run --allow-all ./scripts/start-with-tailscale.ts",
    "ios": "expo start",
    "ios:sim": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "sync-scripts": "deno run --allow-all ../outdoor_post/main.ts export-outdoor-script",
    "build:ios": "eas build --platform ios --profile simulator",
    "build:ios:device": "eas build --platform ios --profile preview",
    "build:ios:simulator": "eas build --platform ios --profile simulator",
    "build:android": "eas build --platform android --profile android",
    "build:ios:production": "eas build --platform ios --profile production"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native/virtualized-lists": "^0.81.5",
    "@turn/outdoor-ui": "file:../outdoor-ui",
    "expo": "~54.0.35",
    "expo-asset": "~12.0.12",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-keep-awake": "~15.0.8",
    "expo-media-library": "~18.2.1",
    "expo-modules-core": "~3.0.29",
    "expo-screen-orientation": "~9.0.9",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-video": "~3.0.16",
    "expo-video-thumbnails": "~10.0.8",
    "outdoor-icloud-inbox": "file:./modules/outdoor-icloud-inbox",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.0",
    "typescript": "~5.9.2"
  }
}
