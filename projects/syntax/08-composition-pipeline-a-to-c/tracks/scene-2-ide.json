{
  "version": 1,
  "typing": {
    "charsPerSecond": 28,
    "fullText": "@notation({g} ~ \" ∘ \" ~ {f})\nstructure Composition<A B C: Set<Any>, f: Function<A, B>, g: Function<B, C>>: Function<A, C> {\n    apply(domain: A): C\n    laws {\n        def {\n            forall x in A\n            |- apply(x) = g.apply(f.apply(x))\n        }\n    }\n}"
  },
  "proofPanel": {
    "steps": [
      {
        "label": "open goal",
        "goal": "⊢ target proposition"
      },
      {
        "label": "apply tactic",
        "goal": "subgoal after apply"
      },
      {
        "label": "close branch",
        "goal": "no open goals"
      }
    ]
  },
  "interactions": [
    {
      "atSeconds": 1.5,
      "kind": "click-proof-step",
      "stepIndex": 0
    },
    {
      "atSeconds": 3.2,
      "kind": "click-proof-step",
      "stepIndex": 1
    },
    {
      "atSeconds": 5,
      "kind": "click-branch",
      "branchId": "main"
    }
  ]
}
